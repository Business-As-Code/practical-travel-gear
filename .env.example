# DCASH-7 x402 TESTNET config. Copy to .env (gitignored) or run:
#   npm run x402:wallet
# TESTNET ONLY — Base Sepolia (eip155:84532). Never put real funds on this key.

# Buyer wallet (generated by scripts/x402-gen-wallet.mjs). NEVER commit a real key.
X402_BUYER_PRIVATE_KEY=0x<testnet-private-key>
X402_BUYER_ADDRESS=0x<testnet-buyer-address>

# Seller receiving address (payTo). Required by the server route.
X402_PAY_TO_ADDRESS=0x<seller-address>

# Open x402 testnet facilitator (verify + settle). Default shown.
X402_FACILITATOR_URL=https://x402.org/facilitator
