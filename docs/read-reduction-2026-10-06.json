  "changes": {
    "taxonomy": [
      "Replace full tag-list queries with indexed ten-link query.",
      "Remove unconditional all-taxonomy term prefetch with pinned, reproducible EmDash 0.42 patch.",
      "Resolve an archive term by slug instead of fetching every term.",
      "Retain taxonomy invalidation tags on cached HTML."
    ],
    "listing": [
      "Add partial indexes for public post and guide listing ordering.",
      "Use metadata-only cards for sidebar recent posts."
    ],
    "cleanup": [
      "Use indexed victim selection instead of scanning retained rows with NOT IN.",
      "Keep newest ten thousand rows, including tied timestamps; cleanup remains on native cron."
    ],
    "scanner": [
      "Reject PHP, .env, .git and wp-admin probes before EmDash initialization.",
      "Preserve CMS media and legacy WordPress uploads.",
      "Implemented in Worker because current token cannot read or write zone WAF rules."
    ],
    "search": [
      "One SQLite Durable Object holds consistent quota counters shared by the public search page, API, and suggestions.",
      "Per client: twenty requests per fixed ten-second window and sixty per fixed minute.",
      "Requests lacking a trusted client IP share a fallback quota. Raw IPs are not stored in quota table; keys use SHA256.",
      "Expired counter rows removed on next activity, at most once per minute.",
      "No D1 for quota checks, scanner denials, or 429 refusals.",
      "Autocomplete waits 450ms and requests eight results.",
      "Public page cache hits may return without Worker/quota execution; they also do not query D1."
    ]
  },
