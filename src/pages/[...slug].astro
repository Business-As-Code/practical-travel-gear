---
/**
 * Catch-all route for WordPress-style root-level URLs.
 *
 * WordPress used /%postname%/ so posts live at /:slug.
 * This route checks for a post first, then a page, and rewrites
 * to the appropriate handler without changing the URL.
 */
import { getEmDashEntry } from "emdash";
import { rewriteNotFound } from "../lib/not-found";

const slugSegments = Astro.params.slug;
if (!slugSegments) {
	return rewriteNotFound(Astro);
}

// Date-based WP permalinks only: /2016/my-post or /2016/05/my-post.
// Do not strip /page/, /author/, /feed/ — those are leftover WP prefixes.
const segments = slugSegments.split("/").filter(Boolean);
if (segments.length > 1) {
	const year = /^\d{4}$/.test(segments[0]);
	const month = segments.length === 3 && /^\d{1,2}$/.test(segments[1]);
	if (year && (segments.length === 2 || month)) {
		return Astro.redirect(`/${segments[segments.length - 1]}`, 301);
	}
	return rewriteNotFound(Astro);
}

const slug = segments[0];

// Build a rewrite request with a marker header so the target route
// knows this is a rewrite (and won't redirect back here).
function rewriteTo(path: string) {
	const url = new URL(path, Astro.url.origin);
	return Astro.rewrite(
		new Request(url, {
			headers: new Headers([
				...Astro.request.headers.entries(),
				["X-Rewrite", "1"],
			]),
		})
	);
}

// Try post first (most common). Stash the full result on locals so the
// rewritten target route can skip a redundant D1 lookup.
const postResult = await getEmDashEntry("posts", slug);
if (postResult.entry) {
	Astro.locals.prefetchedEntry = { collection: "posts", slug, result: postResult };
	return rewriteTo(`/posts/${slug}`);
}

const pageResult = await getEmDashEntry("pages", slug);
if (pageResult.entry) {
	Astro.locals.prefetchedEntry = { collection: "pages", slug, result: pageResult };
	return rewriteTo(`/pages/${slug}`);
}

return rewriteNotFound(Astro);
---
