---
import { listCards, nextListingHref, parseListingAfter } from "../../lib/listing-cards";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";

Astro.cache.set({ maxAge: 300, tags: ["guides"] });
const { cards: guides, hasMore } = await listCards("guides", {
	limit: 21,
	after: parseListingAfter(Astro.url.searchParams.get("after")),
});
const nextHref = nextListingHref("/guides", guides, hasMore);
---

<Base
	title="Buyer's Guides"
	description="In-depth travel gear buying guides. Tested on the road."
>
	<section class="archive-hero">
		<div class="container">
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<a href="/">Home</a>
				<span class="sep">/</span>
				<span>Guides</span>
			</nav>
			<span class="archive-kicker">Buyer's Guides</span>
			<h1 class="archive-title">In-depth gear guides.</h1>
			<p class="dek">
				Cut through the marketing. Every guide is tested, ranked, and
				independently written.
				{guides.length > 0 && (
					<span class="count-note">
						{" "}· {guides.length} {guides.length === 1 ? "guide" : "guides"} on this page
					</span>
				)}
			</p>
		</div>
	</section>

	<section class="archive-body">
		<div class="container">
			{guides.length === 0 ? (
				<p class="no-posts">No guides yet.</p>
			) : (
				<div class="river">
					{guides.map((guide) => (
						<PostCard
							title={guide.title}
							excerpt={guide.excerpt ?? undefined}
							featuredImage={guide.featuredImage}
							href={guide.href}
							date={guide.publishedAt ?? undefined}
							author={guide.authorName}
							kicker="Guide"
							variant="feature"
						/>
					))}
				</div>
			)}
			{nextHref && (
				<div class="pagination"><a class="page-link" href={nextHref}>More guides →</a></div>
			)}
		</div>
	</section>
</Base>

<style>
	.pagination {
		display: flex;
		justify-content: center;
		padding: 48px 0 0;
	}
	.page-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 10px 20px;
		background: var(--ink);
		color: var(--bg);
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		border-radius: 999px;
		text-decoration: none;
		transition: background var(--transition-fast);
	}
	.page-link:hover { background: var(--accent); }

	.archive-hero {
		padding: 40px 0 28px;
		border-bottom: 1px solid var(--rule);
	}
	.breadcrumb {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--ink-3);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: 16px;
	}
	.breadcrumb a { color: var(--ink-3); }
	.breadcrumb a:hover { color: var(--accent); }
	.breadcrumb .sep { margin: 0 8px; color: var(--rule-2); }

	.archive-kicker {
		display: inline-block;
		background: var(--accent);
		color: white;
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		padding: 4px 8px;
		margin-bottom: 14px;
	}
	.archive-title {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(32px, 4.5vw, 56px);
		line-height: 1.02;
		letter-spacing: -0.032em;
		margin: 0 0 14px;
		max-width: 900px;
	}
	.dek {
		font-size: 18px;
		color: var(--ink-2);
		line-height: 1.5;
		max-width: 720px;
		margin: 0;
	}
	.count-note {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--ink-3);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.archive-body {
		padding: 40px 0 64px;
	}

	.river {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 40px 28px;
	}
	@media (max-width: 900px) {
		.river { grid-template-columns: 1fr; }
	}

	.no-posts {
		color: var(--ink-3);
		font-size: 15px;
		padding: 32px 0;
	}
</style>
