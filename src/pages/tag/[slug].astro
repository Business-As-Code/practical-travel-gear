---
import { getArchiveTerm } from "../../lib/archive-term";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { rewriteNotFound } from "../../lib/not-found";
import { listCards } from "../../lib/listing-cards";

const { slug } = Astro.params;
const term = await getArchiveTerm("tag", slug);
const rawPage = Number(Astro.url.searchParams.get("page") ?? "1");
const page = Number.isSafeInteger(rawPage) && rawPage > 0 ? Math.min(rawPage, 10000) : 1;
Astro.cache.set({ maxAge: 300, tags: ["posts", "emdash:taxonomy:tag"] });

if (!term) {
	return rewriteNotFound(Astro);
}

const { cards: posts, hasMore } = await listCards("posts", {
	limit: 24,
	offset: (page - 1) * 24,
	term: { name: "tag", slug: term.slug },
});
---

<Base
	title={`Posts tagged "${term.label}"`}
	description={`All posts tagged with ${term.label}`}
>
	<section class="archive-hero">
		<div class="container">
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<a href="/">Home</a>
				<span class="sep">/</span>
				<span>Tags</span>
			</nav>
			<span class="archive-kicker">Tag</span>
			<h1 class="archive-title">#{term.label}</h1>
			<p class="archive-count">
				{posts.length}
				{posts.length === 1 ? "story" : "stories"} on this page
			</p>
		</div>
	</section>

	<section class="archive-body">
		<div class="container">
			{posts.length === 0 ? (
				<p class="no-posts">No stories with this tag yet.</p>
			) : (
				<div class="river">
					{posts.map((post) => (
						<PostCard
							title={post.title}
							excerpt={post.excerpt ?? undefined}
							featuredImage={post.featuredImage}
							href={post.href}
							date={post.publishedAt ?? undefined}
							author={post.authorName}
						/>
					))}
				</div>
			)}
			{hasMore && <p class="pagination"><a href={`/tag/${slug}?page=${page + 1}`}>Older stories →</a></p>}
		</div>
	</section>
</Base>

<style>
	.archive-hero {
		padding: 40px 0 28px;
		border-bottom: 1px solid var(--rule);
	}
	.breadcrumb {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--ink-3);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: 16px;
	}
	.breadcrumb a { color: var(--ink-3); }
	.breadcrumb a:hover { color: var(--accent); }
	.breadcrumb .sep { margin: 0 8px; color: var(--rule-2); }

	.archive-kicker {
		display: inline-block;
		background: var(--ink);
		color: var(--bg);
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		padding: 4px 8px;
		margin-bottom: 14px;
	}
	.archive-title {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(32px, 4.5vw, 56px);
		line-height: 1.02;
		letter-spacing: -0.032em;
		margin: 0 0 10px;
	}
	.archive-count {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--ink-3);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin: 0;
	}

	.archive-body {
		padding: 40px 0 64px;
	}

	.river {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 32px 24px;
	}
	@media (max-width: 900px) {
		.river { grid-template-columns: repeat(2, 1fr); }
	}
	@media (max-width: 600px) {
		.river { grid-template-columns: 1fr; }
	}

	.no-posts {
		color: var(--ink-3);
		font-size: 15px;
		padding: 32px 0;
	}
</style>
