{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "practical-travel-gear",
	"account_id": "eddf7805053d5e32afd090c3ec22126c",
	"main": "./src/worker.ts",
	"workers_dev": false,
	"preview_urls": false,
	"cache": { "enabled": true, "cross_version_cache": false },
	"placement": { "mode": "targeted", "region": "aws:us-west-2" },
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"kv_namespaces": [
		{ "binding": "SESSION", "id": "7a1de3ae7ccf4e608abb6c2a0c0ba09e" }
	],
	"triggers": { "crons": ["*/5 * * * *"] },
	"compatibility_date": "2026-03-29",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "practical-travel-gear","database_id": "d84b7ddc-76d7-4d64-92bb-c3e7fc7d4dec",
			// Run `wrangler d1 create my-emdash-site` and paste the ID here
		},
	],
	"images": { "binding": "IMAGES" },
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "practical-travel-gear","preview_bucket_name": "practical-travel-gear",
		},
	],
	"observability": {
		"enabled": true,
	},
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
}
