{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ptg-cleanup-local-only",
  "main": "dist/server/entry.mjs",
  "compatibility_date": "2026-03-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {"directory": "dist/client", "binding": "ASSETS"},
  "d1_databases": [{"binding":"DB","database_name":"ptg-cleanup-local-only","database_id":"00000000-0000-0000-0000-000000000000","remote":false}],
  "r2_buckets": [{"binding":"MEDIA","bucket_name":"ptg-cleanup-local-only","remote":false}],
  "kv_namespaces": [{"binding":"SESSION","id":"00000000000000000000000000000000","remote":false}],
  "worker_loaders": [{"binding":"LOADER"}],
  "version_metadata": {"binding":"CF_VERSION_METADATA"},
  "cache": {"enabled":true,"cross_version_cache":false},
  "triggers": {"crons":["*/5 * * * *"]}
}
